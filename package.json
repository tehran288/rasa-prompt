{
  "name": "rasa-prompt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:bot:telegram": "PLATFORM=telegram tsx watch apps/bot/src/main.ts",
    "dev:bot:bale": "PLATFORM=bale tsx watch apps/bot/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "build": "pnpm -r --filter ./apps/* build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @rasa/db generate",
    "db:migrate": "pnpm --filter @rasa/db migrate",
    "db:seed": "pnpm --filter @rasa/db seed",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.10.0",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
