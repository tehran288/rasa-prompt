# ─── Core ───
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://rasa:rasa@localhost:5432/rasa

# ─── Bot (one process per platform) ───
PLATFORM=telegram            # telegram | bale
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
BOT_MODE=polling             # polling (dev) | webhook (prod)
WEBHOOK_PUBLIC_URL=          # e.g. https://bots.rasa-prompt.ir
WEBHOOK_SECRET=              # random string, checked on every webhook call
PORT=8080

TELEGRAM_ADMIN_IDS=          # comma-separated numeric user ids
BALE_ADMIN_IDS=
TELEGRAM_ADMIN_CHAT_ID=      # reports, alerts, review queue
BALE_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=         # @channel or -100… for "prompt of the day"
BALE_CHANNEL_ID=

# ─── Payments ───
BALE_WALLET_PROVIDER_TOKEN=  # from @BotFather in Bale (wallet)
WEB_BASE_URL=https://rasa-prompt.ir

# ─── AI ───
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=      # optional self-hosted / permitted provider
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
AI_ROUTES=                   # JSON: {"concierge":"anthropic:claude-haiku-5-5", ...}
AI_DAILY_BUDGET_USD=10

# ─── Trend intelligence sources (optional) ───
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
PRODUCTHUNT_TOKEN=
SERPAPI_KEY=
INTEL_DAILY_DRAFTS=10
INTEL_AUTO_PUBLISH=false

FREE_AI_BUILDS_PER_DAY=3
REFERRAL_REWARD_CREDITS=50

# ─── Tests ───
TEST_DATABASE_URL=postgres://rasa:rasa@localhost:5432/rasa_test
