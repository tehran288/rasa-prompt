# ─── Core ───
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://rasa:rasa@localhost:5432/rasa

# ─── Bot (one process per platform) ───
# telegram | bale
PLATFORM=telegram
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
# polling (dev) | webhook (prod)
BOT_MODE=polling
# e.g. https://bots.rasa-prompt.ir
WEBHOOK_PUBLIC_URL=
# random string, checked on every webhook call
WEBHOOK_SECRET=
PORT=8080

# comma-separated numeric user ids
TELEGRAM_ADMIN_IDS=
BALE_ADMIN_IDS=
# reports, alerts, review queue
TELEGRAM_ADMIN_CHAT_ID=
BALE_ADMIN_CHAT_ID=
# @channel or -100… for "prompt of the day"
TELEGRAM_CHANNEL_ID=
BALE_CHANNEL_ID=

# ─── Payments ───
# from @BotFather in Bale (wallet)
BALE_WALLET_PROVIDER_TOKEN=
WEB_BASE_URL=https://rasa-prompt.ir

# ─── AI ───
ANTHROPIC_API_KEY=
# optional self-hosted / permitted provider
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# JSON: {"concierge":"anthropic:claude-haiku-5-5", ...}
AI_ROUTES=
AI_DAILY_BUDGET_USD=10

# ─── Trend intelligence sources (optional) ───
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
PRODUCTHUNT_TOKEN=
SERPAPI_KEY=
INTEL_DAILY_DRAFTS=10
INTEL_AUTO_PUBLISH=false

FREE_AI_BUILDS_PER_DAY=3
REFERRAL_REWARD_CREDITS=50

# ─── Tests ───
TEST_DATABASE_URL=postgres://rasa:rasa@localhost:5432/rasa_test
