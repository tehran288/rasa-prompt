# Compose-level variables (interpolated into docker-compose.yml). Copy to infra/.env.
# Application settings live in the repo-root .env (see /.env.example), loaded via env_file.

# Images (built by .github/workflows/docker.yml)
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=latest

# Postgres
POSTGRES_USER=rasa
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=rasa
# Bind address for the DB port on the host. Keep 127.0.0.1 unless a Bale bot in Iran connects
# over WireGuard — then use the WireGuard interface IP (e.g. 10.8.0.1). NEVER 0.0.0.0.
POSTGRES_BIND=127.0.0.1

# Webhook hostnames served by Caddy (A records → this server)
TELEGRAM_WEBHOOK_HOST=tg.bots.rasa-prompt.ir
BALE_WEBHOOK_HOST=bale.bots.rasa-prompt.ir
ACME_EMAIL=ops@rasa-prompt.ir

# Nightly encrypted pg_dump to S3-compatible storage (Cloudflare R2, ArvanCloud, MinIO…)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_PASSPHRASE=change-me-gpg-passphrase
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=rasa-backups
S3_PREFIX=postgres
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
